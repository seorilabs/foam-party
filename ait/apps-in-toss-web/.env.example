# AppsInToss 통합 광고(Toss Ads + AdMob) 광고 그룹 ID.
# AIT 콘솔 > 수익화 > 인앱 광고에서 발급받은 광고 그룹 ID를 넣는다.
# 미설정(빈 값)이면 광고는 자동으로 비활성화된다(supported()=false → no-op).
# 개발/테스트용 ID(실 광고 ID로 테스트 금지):
#   전면형(interstitial): ait-ad-test-interstitial-id
#   보상형(rewarded):     ait-ad-test-rewarded-id
# 보상형(rewarded): 무료 거품폭탄(foam_bomb_free)
VITE_TOSS_REWARDED_AD_GROUP_ID=
# 보상형(rewarded): 레벨 종료 코인 2배(level_reward_2x)
VITE_TOSS_LEVEL_REWARD_AD_GROUP_ID=
# 전면형(interstitial): game-over(game_over)
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=

# GA4 Measurement Protocol api_secret. Firebase Analytics Web SDK가 WebView에서
# 미동작(isSupported=false/gtag 차단)할 때 순수 fetch로 GA4에 이벤트를 보내는
# 폴백에 사용. 미설정 시 폴백 비활성. 생성: GA4 관리 > 데이터 스트림 > 웹 스트림
# (measurementId G-CJRMGYTSLW) > Measurement Protocol API 비밀 > 만들기.
VITE_GA4_MP_API_SECRET=

# Firebase Web (AIT/web 애널리틱스·Remote Config) 설정. firebaseRuntime.ts 참고.
# 값 출처: firebase apps:sdkconfig WEB <webAppId> --project foam-party
# 클라이언트 공개 설정값이며, API_KEY/PROJECT_ID/APP_ID 3개가 모두 있어야 Firebase가 init된다.
# (하나라도 비면 firebaseOptions()가 null → Analytics/Remote Config no-op)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=foam-party
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=foam-party.firebaseapp.com
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=72898706664
VITE_FIREBASE_STORAGE_BUCKET=foam-party.firebasestorage.app
