# AppsInToss 통합 광고(Toss Ads + AdMob) 광고 그룹 ID.
# AIT 콘솔 > 수익화 > 인앱 광고에서 발급받은 광고 그룹 ID를 넣는다.
# 미설정(빈 값)이면 광고는 자동으로 비활성화된다(supported()=false → no-op).
# 개발/테스트용 ID(실 광고 ID로 테스트 금지):
#   전면형(interstitial): ait-ad-test-interstitial-id
#   보상형(rewarded):     ait-ad-test-rewarded-id
# 보상형(rewarded): 무료 거품폭탄(foam_bomb_free)
VITE_TOSS_REWARDED_AD_GROUP_ID=
# 보상형(rewarded): 레벨 종료 코인 2배(level_reward_2x)
VITE_TOSS_LEVEL_REWARD_AD_GROUP_ID=
# 전면형(interstitial): game-over(game_over)
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=

# AIT 심사 번들은 클라이언트 비밀값을 포함하지 않는다.
# 애널리틱스는 비활성이며 서버 프록시 도입 전까지 재활성하지 않는다.
