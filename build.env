# 이 repo 의 빌드 툴체인 선언. 여기가 유일한 선언이다.
#
# 계약: seorilabs/.github docs/ci-cd/build-toolchain-contract.md
# GODOT_VERSION 은 빌더 이미지 태그이기도 하다. 엔진을 올릴 때 이미지 태그를 굽고
# 이 값만 바꾸면 로컬·GitHub Actions·Cloud Build 가 함께 따라온다.
GODOT_VERSION=4.7.2
GODOT_STATUS=stable
ANDROID_BUILDER_IMAGE=asia-northeast3-docker.pkg.dev/seorilabs-ci/builders/godot-android-builder

# Godot 프로젝트와 repo-local 도구 위치.
PROJECT_DIR=godot
SCRIPTS_DIR=tools

# 산출물. 호출부가 경로를 알아맞히지 않도록 고정한다.
AAB_PATH=build/android/foam-party-internal.aab
