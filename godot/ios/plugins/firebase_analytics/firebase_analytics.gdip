[config]

name="GodotxFirebaseAnalytics"
binary="GodotxFirebaseAnalytics.xcframework"

initialization="initialize_godotx_firebase_analytics_module"
deinitialization="uninitialize_godotx_firebase_analytics_module"

[dependencies]

linked=[]

embedded=[]

system=["UserNotifications.framework", "UIKit.framework", "Foundation.framework"]

capabilities=[]

files=[]

linker_flags=["-ObjC", "-L$(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME)"]
