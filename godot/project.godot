; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Foam Party"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.976471, 0.984314, 0.984314, 1)
boot_splash/image="res://assets/branding/seori-labs-boot-splash-1024.png"
config/icon="res://assets/AppIcon.png"

[audio]

general/ios/session_category=3

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godotx_firebase/plugin.cfg", "res://addons/admob/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
